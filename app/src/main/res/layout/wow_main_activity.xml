<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LLWowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:id="@+id/TVWowTitle"
                android:text="@string/wow_title"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:id="@+id/TVWowSubtitle"
                android:text="@string/wow_subtitle"
                android:textSize="14sp"
                android:textColor="?attr/colorSecondaryText"/>

            <!-- What the app is pointed at, in a small card. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:id="@+id/LLWowStatusPanel"
                android:background="?attr/colorSecondarySurface">

                <TextView
                    android:id="@+id/TVWowFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/colorSecondaryText"/>

                <TextView
                    android:id="@+id/TVWowStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="?attr/colorPrimaryText"/>

                <TextView
                    android:id="@+id/TVWowRealmlist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="?attr/colorSecondaryText"/>
            </LinearLayout>

            <!-- Pushes the buttons and links to the bottom of the screen. -->
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Play (a little wider than the word); Update on its right when a newer version is
                 out. The row is centred, so Play alone is centred and Play + Update together are. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/BTPlay"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="232dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/wow_play"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:backgroundTint="?attr/colorAccent"/>

                <Button
                    android:id="@+id/BTUpdate"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp"
                    android:visibility="gone"
                    android:nextFocusRight="@id/BTUpdate"
                    android:nextFocusUp="@id/BTUpdate"
                    android:nextFocusDown="@id/BTDonate"
                    android:nextFocusLeft="@id/BTPlay"/>
            </LinearLayout>

            <!-- Change Game Folder and Donate, as wide as Play. Spacing is on an 8dp grid. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/BTSelectFolder"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="232dp"
                    android:layout_height="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:maxLines="1"
                    android:text="@string/wow_select_game_folder"/>

                <Button
                    android:id="@+id/BTDonate"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="232dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:maxLines="1"
                    android:text="@string/wow_donate"/>
            </LinearLayout>

            <!-- WoW Settings exactly in the middle (under Play): the links on either side each
                 get half of the rest of the row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end">

                <Button
                    android:id="@+id/BTAdvanced"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="?attr/colorSecondaryText"
                    android:text="@string/wow_advanced"/>
                </LinearLayout>

                <Button
                    android:id="@+id/BTWowSettings"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="?attr/colorSecondaryText"
                    android:text="@string/wow_settings"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start">

                <Button
                    android:id="@+id/BTContainerSettings"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:foreground="@drawable/focus_border"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="?attr/colorSecondaryText"
                    android:text="@string/wow_container_settings"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
